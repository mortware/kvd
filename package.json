{
  "name": "@mortware/kvd",
  "bin": {
    "kvd": "dist/cli.js"
  },
  "version": "0.0.18",
  "description": "CLI for managing karaoke-version track catalog imports, assets, and downloads",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "help": "npm run build && node dist/cli.js help",
    "download": "npm run build && node dist/cli.js download",
    "release": "npm version patch && npm run build && npm publish"
  },
  "keywords": [
    "cli",
    "kvd",
    "karaoke",
    "karaoke-version"
  ],
  "author": "mortware",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@azure/cosmos": "^4.1.1",
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.24.0",
    "@azure/storage-queue": "^12.23.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.46.1",
    "uuid": "^10.0.0",
    "zod": "^4.3.6"
  }
}